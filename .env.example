# ───────────────────────── CREW CAR — variáveis de ambiente ─────────────────────────
# Copie para .env.local (desenvolvimento) ou configure no seu fornecedor de alojamento.
# Nunca coloque estas credenciais em código ou em variáveis NEXT_PUBLIC_*.

# Ligação PostgreSQL (local, Supabase, Neon, RDS…). Em Supabase use a "connection string"
# do pooler em modo "Session" ou a ligação direta, com o utilizador "postgres".
DATABASE_URL=postgres://crewcar:crewcar_dev@localhost:5432/crewcar

# Endereço público do site (usado em SEO, sitemap, partilhas e verificação de origem).
SITE_URL=http://localhost:3000

# Segredo aleatório (mínimo 32 caracteres) usado para assinar tokens anti-spam.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=troque-este-valor-por-um-segredo-aleatorio-com-48-bytes

# Armazenamento das fotografias: "local" (disco) ou "s3" (Supabase Storage, AWS S3, R2…).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Apenas para STORAGE_DRIVER=s3. Para Supabase Storage:
#   S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3
#   S3_REGION=<região do projeto, ex.: eu-west-3>
#   S3_BUCKET=crewcar (bucket PRIVADO — os ficheiros são servidos pela aplicação)
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: Project Settings → Storage → S3 Access Keys
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
